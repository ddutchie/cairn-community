{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/ddutchie/cairn-community/main/schema.json",
  "title": "Cairn Community Connector",
  "description": "One connectors/<id>/connector.json — an installable MCP server or HTTP service. manifest.json is COMPILED from these by scripts/build-manifest.mjs; never hand-edit the manifest.",
  "type": "object",
  "required": ["kind", "author", "version", "category", "tags", "blurb", "definition"],
  "additionalProperties": false,
  "properties": {
    "kind": { "type": "string", "enum": ["mcp", "service"] },
    "author": { "type": "string", "description": "GitHub handle/org maintaining this entry." },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "SemVer of THIS entry; bump to push an update to installed users." },
    "category": {
      "type": "string",
      "description": "The single category chip this connector groups under in Browse Community.",
      "enum": [
        "Project management",
        "Dev & Code",
        "Docs & Knowledge",
        "CRM & Support",
        "Search & Web",
        "Finance",
        "Design",
        "Automation",
        "Utilities"
      ]
    },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "Freeform keywords for search only (not shown as chips)." },
    "blurb": { "type": "string", "maxLength": 200, "description": "One-line description for the browse card." },
    "brandColor": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
    "icon": {
      "type": "object",
      "description": "Connector logo. Use exactly ONE of: slug (a simpleicons.org slug — fetched + sanitized by CI), svg (inline SVG string), or file (a .svg next to connector.json). Omit for the app's generic fallback.",
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "description": "simpleicons.org slug, e.g. \"jira\" (CC0)." },
        "svg": { "type": "string", "description": "Inline SVG markup (allowlist-sanitized at build)." },
        "file": { "type": "string", "description": "Relative .svg filename beside connector.json." }
      }
    },
    "definition": {
      "oneOf": [{ "$ref": "#/definitions/McpDefinition" }, { "$ref": "#/definitions/ServiceDefinition" }]
    }
  },
  "definitions": {
    "McpDefinition": {
      "type": "object",
      "required": ["name", "transport", "baseUrl", "enabled"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "transport": { "type": "string", "enum": ["sse", "http"] },
        "baseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "authMode": { "type": "string", "enum": ["none", "oauth"] },
        "oauthScope": { "type": "string" },
        "disabledTools": { "type": "array", "items": { "type": "string" } },
        "enabled": { "type": "boolean" }
      }
    },
    "ServiceDefinition": {
      "type": "object",
      "required": ["name", "apiUrl", "method", "toolDefinition", "enabled"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "apiUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE"] },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "toolDefinition": { "type": "string", "description": "Stringified OpenAI tool JSON." },
        "responseKeys": { "type": "array", "items": { "type": "string" } },
        "apiKeyUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "authMode": {
          "type": "string",
          "enum": ["none", "oauth"],
          "description": "'none' (default) = static/keychain header secrets. 'oauth' = OAuth 2.1 browser sign-in; Cairn auto-refreshes tokens and injects Authorization: Bearer per request."
        },
        "oauth": {
          "type": "object",
          "additionalProperties": false,
          "description": "OAuth parameters for authMode:'oauth'. Omit serverUrl to run discovery + dynamic client registration against the apiUrl origin (works for any modern DCR-capable authorization server).",
          "properties": {
            "serverUrl": { "type": "string", "format": "uri", "pattern": "^https://", "description": "Authorization-server discovery base (defaults to the apiUrl origin)." },
            "scope": { "type": "string", "description": "Requested OAuth scope (space-delimited)." },
            "clientId": { "type": "string", "description": "Preregistered client id for vendors without DCR (Phase C)." },
            "authorizationUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
            "tokenUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
          }
        },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
