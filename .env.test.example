# Cairn Community — test environment variables
# Copy this file to .env.test (gitignored) and fill in your values. Run with:
#
#   npm run test:credits
#
# For each provider that declares a `credits` descriptor AND has a key set here,
# the script hits its balance endpoint and verifies the response is 2xx + parses
# into the declared shape. Providers without a key are skipped.

# OpenAI (credits shape "openai-grants") — https://platform.openai.com/api-keys
# Endpoint probed: https://api.openai.com/v1/dashboard/billing/credit_grants
OPENAI_API_KEY=

# OpenRouter (credits shape "openrouter") — https://openrouter.ai/keys
# Endpoint probed: https://openrouter.ai/api/v1/key
OPENROUTER_API_KEY=

# DeepSeek (credits shape "deepseek") — https://platform.deepseek.com/api_keys
# Endpoint probed: https://api.deepseek.com/user/balance
DEEPSEEK_API_KEY=

# Neuralwatt (credits shape "neuralwatt") — https://portal.neuralwatt.com/
# Endpoint probed: https://api.neuralwatt.com/v1/quota
NEURALWATT_API_KEY=

# Merge.dev (no credits descriptor yet — /v1/key probed informationally)
# https://www.merge.dev
MERGE_API_KEY=

# Opencode (not in the registry — /v1/key probed informationally at the base
# URL below; override if your deployment differs)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai
